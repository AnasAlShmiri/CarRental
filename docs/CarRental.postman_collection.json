{
  "info": {
    "name": "CarRental API",
    "description": "Car rental management API — Clean Architecture + Repository Pattern.\n\nHOW TO USE\n1. Run the API (default http://localhost:5109).\n2. Send 'Auth / Login' first — it saves the JWT into the collection variable {{token}} automatically, and every protected request uses it.\n3. Cars create/update use multipart/form-data so the photo is picked in the same request (Body > form-data > image > Select Files).\n\nPublic endpoints (no token): car catalogue reads, POST /api/Rentals, GET /api/Rentals/customer/{id}, /health.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5109"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (saves {{token}} automatically)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Returns a JWT. The test script stores it in the collection variable {{token}}.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d && d.token) pm.collectionVariables.set('token', d.token);",
                  "pm.test('token issued', () => pm.expect(d.token).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Echoes the identity inside the token."
          }
        }
      ]
    },
