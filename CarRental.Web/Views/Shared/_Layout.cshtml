@{
    var current = $"{ViewContext.RouteData.Values["controller"]}-{ViewContext.RouteData.Values["action"]}";
    var userName = User.Identity?.Name ?? "المدير";
    var userInitial = string.IsNullOrWhiteSpace(userName) ? "م" : userName[..1].ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — نظام تأجير السيارات</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <div class="app-shell">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <aside class="app-sidebar">
                <a class="sidebar-brand" asp-controller="Dashboard" asp-action="Index" aria-label="العودة إلى لوحة الإحصائيات">
                    <span class="brand-mark">▣</span>
                    <span>
                        <span class="brand-name">تأجير السيارات</span>
                        <span class="brand-sub">لوحة الإدارة</span>
                    </span>
                </a>

                <nav class="sidebar-nav" aria-label="التنقل الرئيسي">
                    <a class="nav-item @(current.StartsWith("Dashboard") ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                        <span class="nav-icon" aria-hidden="true">◫</span><span>لوحة الإحصائيات</span>
                    </a>
                    <a class="nav-item @(current.StartsWith("Cars") ? "active" : "")" asp-controller="Cars" asp-action="Index">
                        <span class="nav-icon" aria-hidden="true">▣</span><span>السيارات</span>
                    </a>
                    <a class="nav-item @(current.StartsWith("Customers") ? "active" : "")" asp-controller="Customers" asp-action="Index">
                        <span class="nav-icon" aria-hidden="true">♙</span><span>العملاء</span>
                    </a>
                    <a class="nav-item @(current.StartsWith("Rentals") ? "active" : "")" asp-controller="Rentals" asp-action="Index">
                        <span class="nav-icon" aria-hidden="true">↔</span><span>الإيجارات</span>
                    </a>
                </nav>

                <div class="sidebar-footer">
                    <span class="sidebar-user" title="@userName">مرحباً، @userName</span>
                    <form asp-controller="Auth" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-logout">
                            <span class="nav-icon" aria-hidden="true">⇥</span><span>تسجيل الخروج</span>
                        </button>
                    </form>
                </div>
            </aside>
        }

        <main class="app-main">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <header class="topbar">
                    <div class="topbar-inner">
                        <div>
                            <h1 class="topbar-title">@ViewData["Title"]</h1>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <span class="topbar-meta d-none d-md-inline">@DateTime.Now.ToString("dddd، d MMMM yyyy", new System.Globalization.CultureInfo("ar"))</span>
                            <span class="avatar-initial" title="@userName">@userInitial</span>
                        </div>
                    </div>
                </header>
            }

            <div class="container-fluid page-content">
                @if (TempData["SuccessMessage"] is string success)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <strong>تم بنجاح: </strong>@success
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] is string error)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>تعذر الإجراء: </strong>@error
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
