@{
    var current = $"{ViewContext.RouteData.Values["controller"]}-{ViewContext.RouteData.Values["action"]}";
    var userName = User.Identity?.Name ?? "المدير";
    var userInitial = string.IsNullOrWhiteSpace(userName) ? "م" : userName[..1].ToUpperInvariant();
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#2563EB" />
    <title>@ViewData["Title"] — كار رنتال</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    @if (isAuthenticated)
    {
        <div class="mobile-sidebar-backdrop" data-sidebar-dismiss></div>
        <aside class="app-sidebar" id="appSidebar">
            <div class="sidebar-top">
                <a class="sidebar-brand" asp-controller="Dashboard" asp-action="Index" aria-label="العودة إلى لوحة التحكم">
                    <span class="brand-mark"><i class="bi bi-car-front-fill" aria-hidden="true"></i></span>
                    <span class="brand-copy">
                        <span class="brand-name">كار رنتال</span>
                        <span class="brand-sub">إدارة أسطولك بذكاء</span>
                    </span>
                </a>
                <button class="sidebar-close" type="button" data-sidebar-dismiss aria-label="إغلاق القائمة">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>

            <nav class="sidebar-nav" aria-label="التنقل الرئيسي">
                <span class="sidebar-section-label">الرئيسية</span>
                <a class="nav-item @(current.StartsWith("Dashboard") ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                    <span class="nav-icon"><i class="bi bi-grid-1x2-fill" aria-hidden="true"></i></span>
                    <span>لوحة التحكم</span>
                    <i class="bi bi-chevron-left nav-chevron" aria-hidden="true"></i>
                </a>
                <span class="sidebar-section-label mt-3">الإدارة</span>
                <a class="nav-item @(current.StartsWith("Cars") ? "active" : "")" asp-controller="Cars" asp-action="Index">
                    <span class="nav-icon"><i class="bi bi-car-front-fill" aria-hidden="true"></i></span>
                    <span>السيارات</span>
                    <i class="bi bi-chevron-left nav-chevron" aria-hidden="true"></i>
                </a>
                <a class="nav-item @(current.StartsWith("Customers") ? "active" : "")" asp-controller="Customers" asp-action="Index">
                    <span class="nav-icon"><i class="bi bi-people-fill" aria-hidden="true"></i></span>
                    <span>العملاء</span>
                    <i class="bi bi-chevron-left nav-chevron" aria-hidden="true"></i>
                </a>
                <a class="nav-item @(current.StartsWith("Rentals") ? "active" : "")" asp-controller="Rentals" asp-action="Index">
                    <span class="nav-icon"><i class="bi bi-calendar2-check-fill" aria-hidden="true"></i></span>
                    <span>الإيجارات</span>
                    <i class="bi bi-chevron-left nav-chevron" aria-hidden="true"></i>
                </a>
            </nav>

            <div class="sidebar-promo">
                <span class="promo-icon"><i class="bi bi-stars" aria-hidden="true"></i></span>
                <strong>إدارة أسهل</strong>
                <span>تابع عملياتك اليومية من مكان واحد.</span>
            </div>

            <div class="sidebar-footer">
                <div class="sidebar-user-card">
                    <span class="user-avatar">@userInitial</span>
                    <span class="user-copy"><strong>@userName</strong><small>مدير النظام</small></span>
                    <i class="bi bi-three-dots-vertical user-more" aria-hidden="true"></i>
                </div>
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-logout">
                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i><span>تسجيل الخروج</span>
                    </button>
                </form>
            </div>
        </aside>
    }

    <div class="app-main @(isAuthenticated ? "with-sidebar" : "")">
        @if (isAuthenticated)
        {
            <header class="topbar">
                <div class="topbar-inner">
                    <div class="topbar-leading">
                        <button class="mobile-menu-button" type="button" data-sidebar-toggle aria-label="فتح القائمة">
                            <i class="bi bi-list" aria-hidden="true"></i>
                        </button>
                        <div>
                            <span class="topbar-eyebrow">مساحة العمل</span>
                            <h1 class="topbar-title">@ViewData["Title"]</h1>
                        </div>
                    </div>
                    <div class="topbar-actions">
                        <span class="topbar-date"><i class="bi bi-calendar3" aria-hidden="true"></i>@DateTime.Now.ToString("dddd، d MMMM yyyy", new System.Globalization.CultureInfo("ar"))</span>
                        <span class="topbar-divider"></span>
                        <span class="topbar-avatar" title="@userName">@userInitial</span>
                    </div>
                </div>
            </header>
        }

        <main class="container-fluid page-content">
            @if (TempData["SuccessMessage"] is string success)
            {
                <div class="alert app-alert alert-success alert-dismissible fade show" role="alert">
                    <span class="alert-icon"><i class="bi bi-check2-circle" aria-hidden="true"></i></span>
                    <span><strong>تمت العملية بنجاح</strong><small>@success</small></span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] is string error)
            {
                <div class="alert app-alert alert-danger alert-dismissible fade show" role="alert">
                    <span class="alert-icon"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i></span>
                    <span><strong>تعذر تنفيذ العملية</strong><small>@error</small></span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (isAuthenticated)
    {
        <script>
            (() => {
                const sidebar = document.getElementById('appSidebar');
                const toggle = document.querySelector('[data-sidebar-toggle]');
                const dismissers = document.querySelectorAll('[data-sidebar-dismiss]');
                const setOpen = (open) => document.body.classList.toggle('sidebar-open', open);
                toggle?.addEventListener('click', () => setOpen(true));
                dismissers.forEach((item) => item.addEventListener('click', () => setOpen(false)));
                window.addEventListener('resize', () => { if (window.innerWidth > 991) setOpen(false); });
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
