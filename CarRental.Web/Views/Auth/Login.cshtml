@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "تسجيل الدخول";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تسجيل الدخول — نظام تأجير السيارات</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="login-shell">
        <div class="login-card">
            <div class="login-brand">
                <span class="brand-mark">C</span>
                <h3 class="mb-0" style="color: var(--brand-800); font-weight: 800;">نظام تأجير السيارات</h3>
            </div>
            <p class="text-center text-muted mb-4">لوحة الإدارة — سجّل الدخول للمتابعة</p>

            @if (ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger" role="alert">
                    <strong>✕ </strong>
                    <div asp-validation-summary="All" class="text-danger"></div>
                </div>
            }

            <form method="post" asp-action="Login">
                @Html.AntiForgeryToken()
                @if (!string.IsNullOrEmpty(ViewData["ReturnUrl"] as string))
                {
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                }

                <div class="mb-3">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control form-control-lg" autocomplete="username" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control form-control-lg" type="password" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 btn-lg">تسجيل الدخول</button>
            </form>

            <p class="text-center text-muted mt-4 mb-0" style="font-size: .8rem;">
                الحساب الافتراضي للتطوير: <code>admin</code> / <code>Admin&#64;12345</code>
            </p>
        </div>
    </div>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
