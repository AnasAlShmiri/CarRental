@model CarRental.Domain.Models.Rental
@{
    ViewData["Title"] = $"حذف الإيجار #{Model.Id}";
}

<div class="card" style="max-width: 560px;">
    <div class="card-header text-danger">تأكيد الحذف</div>
    <div class="card-body">
        <h5 class="mb-1">إيجار #@Model.Id</h5>
        <div class="text-muted mb-3">
            @(Model.Car is null ? $"سيارة #{Model.CarId}" : $"{Model.Car.Brand} {Model.Car.Model}")
            — @(Model.Customer?.Name ?? $"عميل #{Model.CustomerId}")
            — @Model.TotalPrice.ToString("N2") ر.س — الحالة: @Model.Status
        </div>

        <p class="text-danger fw-semibold">
            حذف الإيجار يُعيد السيارة إلى الكتالوج (إن لم يكن عليها إيجار نشط آخر).
            هل أنت متأكد؟
        </p>

        <form method="post" asp-action="Delete" asp-route-id="@Model.Id" class="d-flex gap-2">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">نعم، احذف</button>
            <a asp-action="Index" class="btn btn-soft">إلغاء</a>
        </form>
    </div>
</div>
