@model CarRental.Domain.Models.Rental
@{
    ViewData["Title"] = $"تفاصيل الإيجار #{Model.Id}";
}

<div class="card" style="max-width: 640px;">
    <div class="card-header">بيانات الإيجار</div>
    <div class="card-body">
        <dl class="row mb-0" style="font-size:.95rem">
            <dt class="col-sm-5">السيارة</dt>
            <dd class="col-sm-7 fw-semibold">@(Model.Car is null ? $"سيارة #{Model.CarId}" : $"{Model.Car.Brand} {Model.Car.Model}")</dd>
            <dt class="col-sm-5">العميل</dt>
            <dd class="col-sm-7 fw-semibold">@(Model.Customer?.Name ?? $"عميل #{Model.CustomerId}")</dd>
            <dt class="col-sm-5">الفترة</dt>
            <dd class="col-sm-7">من @Model.StartDate.ToString("yyyy-MM-dd") إلى @Model.EndDate.ToString("yyyy-MM-dd") (@Model.DurationInDays يوم)</dd>
            <dt class="col-sm-5">السعر الإجمالي</dt>
            <dd class="col-sm-7 fw-bold">@Model.TotalPrice.ToString("N2") ر.س</dd>
            <dt class="col-sm-5">الحالة</dt>
            <dd class="col-sm-7">@StatusPill(Model.Status)</dd>
            <dt class="col-sm-5">تاريخ الإنشاء</dt>
            <dd class="col-sm-7 text-muted">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
        </dl>
    </div>
    <div class="card-footer d-flex gap-2 bg-white border-0">
        <a asp-action="Index" class="btn btn-soft">العودة للقائمة</a>
    </div>
</div>

@functions {
    string StatusPill(string status) => status switch
    {
        "Active"    => "<span class='pill pill-active'>نشط</span>",
        "Completed" => "<span class='pill pill-completed'>مكتمل</span>",
        "Cancelled" => "<span class='pill pill-cancelled'>ملغى</span>",
        _ => $"<span class='pill'>{status}</span>"
    };
}
