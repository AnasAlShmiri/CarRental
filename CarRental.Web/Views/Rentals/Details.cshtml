@model CarRental.Domain.Models.Rental
@{
    ViewData["Title"] = $"تفاصيل الإيجار #{Model.Id}";
    var statusLabel = Model.Status switch
    {
        "Active" => "نشط",
        "Completed" => "مكتمل",
        "Cancelled" => "ملغى",
        _ => Model.Status
    };
    var statusClass = Model.Status switch
    {
        "Active" => "status-active",
        "Completed" => "status-completed",
        "Cancelled" => "status-cancelled",
        _ => "status-pending"
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <span class="login-kicker"><i class="bi bi-receipt"></i> إدارة الحجوزات</span>
        <h2 class="page-heading mt-2 mb-0">تفاصيل الإيجار #@Model.Id</h2>
        <p class="page-description">مراجعة تفاصيل الحجز، السيارة، العميل، والفترة المالية.</p>
    </div>
    <a asp-action="Index" class="btn btn-light btn-sm"><i class="bi bi-arrow-right"></i> العودة للإيجارات</a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between">
                <span><i class="bi bi-file-earmark-text ms-2 text-primary"></i> بيانات الحجز</span>
                <span class="status-badge @statusClass">@statusLabel</span>
            </div>
            <div class="card-body">
                <dl class="row detail-list mb-0">
                    <dt class="col-sm-4">السيارة</dt>
                    <dd class="col-sm-8">@(Model.Car is null ? $"سيارة #{Model.CarId}" : $"{Model.Car.Brand} {Model.Car.Model}")</dd>
                    <dt class="col-sm-4">العميل</dt>
                    <dd class="col-sm-8">@(Model.Customer?.Name ?? $"عميل #{Model.CustomerId}")</dd>
                    <dt class="col-sm-4">تاريخ البداية</dt>
                    <dd class="col-sm-8">@Model.StartDate.ToString("yyyy-MM-dd")</dd>
                    <dt class="col-sm-4">تاريخ النهاية</dt>
                    <dd class="col-sm-8">@Model.EndDate.ToString("yyyy-MM-dd")</dd>
                    <dt class="col-sm-4">مدة الإيجار</dt>
                    <dd class="col-sm-8">@Model.DurationInDays يوم</dd>
                    <dt class="col-sm-4">الإجمالي</dt>
                    <dd class="col-sm-8 text-primary" style="font-size:1.15rem;">@Model.TotalPrice.ToString("N2") ر.س</dd>
                    <dt class="col-sm-4">تاريخ الإنشاء</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column justify-content-center p-4">
                <div class="stat-icon mb-3" style="margin-left:0;"><i class="bi bi-calendar2-check"></i></div>
                <h3 class="h5 fw-bold text-dark">ملخص الحجز</h3>
                <p class="text-muted small">تم إنشاء هذا الحجز بتاريخ @Model.CreatedAt.ToString("yyyy-MM-dd").</p>
                <div class="d-flex justify-content-between align-items-center py-3 mt-2 border-top border-bottom">
                    <span class="text-muted small">عدد الأيام</span>
                    <strong class="text-dark">@Model.DurationInDays</strong>
                </div>
                <div class="d-flex justify-content-between align-items-center py-3">
                    <span class="text-muted small">المبلغ النهائي</span>
                    <strong class="text-primary">@Model.TotalPrice.ToString("N2") ر.س</strong>
                </div>
                <a asp-action="Index" class="btn btn-soft w-100 mt-2"><i class="bi bi-list-ul"></i> عرض كل الإيجارات</a>
            </div>
        </div>
    </div>
</div>
