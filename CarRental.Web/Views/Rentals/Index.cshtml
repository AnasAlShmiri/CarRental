@model IEnumerable<CarRental.Domain.Models.Rental>
@{
    ViewData["Title"] = "الإيجارات";
    var totalRentals = Model.Count();
    var activeRentals = Model.Count(r => r.Status == "Active");
    var completedRentals = Model.Count(r => r.Status == "Completed");
    var cancelledRentals = Model.Count(r => r.Status == "Cancelled");
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <span class="text-uppercase" style="color:var(--primary);font-size:.7rem;font-weight:800;letter-spacing:.04em;">الحجوزات والعمليات</span>
        <h2 class="page-heading mb-0">الإيجارات</h2>
        <p class="page-description">تابع الحجوزات الحالية والمكتملة وأدر حالتها مباشرة.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-calendar2-plus"></i> حجز جديد</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body d-flex align-items-center gap-3"><span class="stat-icon"><i class="bi bi-calendar2-week-fill"></i></span><div><small class="stat-label d-block">كل الإيجارات</small><strong class="stat-value d-block" style="font-size:1.4rem">@totalRentals</strong></div></div></div></div>
    <div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body d-flex align-items-center gap-3"><span class="stat-icon warning"><i class="bi bi-clock-fill"></i></span><div><small class="stat-label d-block">نشطة الآن</small><strong class="stat-value d-block" style="font-size:1.4rem">@activeRentals</strong></div></div></div></div>
    <div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body d-flex align-items-center gap-3"><span class="stat-icon success"><i class="bi bi-check2-circle"></i></span><div><small class="stat-label d-block">مكتملة</small><strong class="stat-value d-block" style="font-size:1.4rem">@completedRentals</strong></div></div></div></div>
    <div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body d-flex align-items-center gap-3"><span class="stat-icon danger"><i class="bi bi-x-circle-fill"></i></span><div><small class="stat-label d-block">ملغاة</small><strong class="stat-value d-block" style="font-size:1.4rem">@cancelledRentals</strong></div></div></div></div>
</div>

<div class="d-flex justify-content-between align-items-center gap-3 mb-3"><div><h3 class="h6 mb-1" style="color:var(--ink);font-weight:800;">سجل الإيجارات</h3><span class="small text-muted">الحجوزات مرتبة حسب أحدث عملية</span></div><span class="small text-muted"><i class="bi bi-receipt me-1"></i> @totalRentals عملية</span></div>

<div class="table-responsive">
    <table class="table">
        <thead><tr><th>السيارة</th><th>العميل</th><th>من</th><th>إلى</th><th>المدة</th><th>السعر الإجمالي</th><th>الحالة</th><th class="text-start">الإجراءات</th></tr></thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td><div class="d-flex align-items-center gap-2"><span class="avatar-initial"><i class="bi bi-car-front"></i></span><span><strong class="d-block">@(r.Car is null ? $"سيارة #{r.CarId}" : $"{r.Car.Brand} {r.Car.Model}")</strong><small class="text-muted">حجز #@r.Id</small></span></div></td>
                    <td><strong>@(r.Customer?.Name ?? $"عميل #{r.CustomerId}")</strong></td>
                    <td class="text-muted" dir="ltr">@r.StartDate.ToString("yyyy-MM-dd")</td>
                    <td class="text-muted" dir="ltr">@r.EndDate.ToString("yyyy-MM-dd")</td>
                    <td><span class="pill pill-active">@r.DurationInDays يوم</span></td>
                    <td><strong>@r.TotalPrice.ToString("N2")</strong> <small class="text-muted">ر.س</small></td>
                    <td>@Html.Raw(StatusPill(r.Status))</td>
                    <td class="text-start text-nowrap">
                        <a asp-action="Details" asp-route-id="@r.Id" class="action-btn" title="التفاصيل"><i class="bi bi-eye"></i></a>
                        @if (r.Status == "Active")
                        {
                            <form method="post" asp-action="Complete" asp-route-id="@r.Id" class="d-inline"><button type="submit" class="action-btn text-success" title="إكمال" onclick="return confirm('إكمال هذا الإيجار وإعادة السيارة للكتالوج؟')"><i class="bi bi-check2"></i></button></form>
                            <form method="post" asp-action="Cancel" asp-route-id="@r.Id" class="d-inline"><button type="submit" class="action-btn text-danger" title="إلغاء" onclick="return confirm('إلغاء هذا الإيجار وإعادة السيارة للكتالوج؟')"><i class="bi bi-x-lg"></i></button></form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="8"><div class="empty-state"><div class="icon"><i class="bi bi-calendar2-x"></i></div><h3>لا توجد إيجارات بعد</h3><p>أنشئ أول حجز لتبدأ متابعة عمليات التأجير من هنا.</p><a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-calendar2-plus"></i> إنشاء حجز</a></div></td></tr>
            }
        </tbody>
    </table>
</div>

@functions {
    string StatusPill(string status) => status switch
    {
        "Active"    => "<span class='pill pill-active'>نشط</span>",
        "Completed" => "<span class='pill pill-completed'>مكتمل</span>",
        "Cancelled" => "<span class='pill pill-cancelled'>ملغى</span>",
        _ => $"<span class='pill'>{status}</span>"
    };
}
