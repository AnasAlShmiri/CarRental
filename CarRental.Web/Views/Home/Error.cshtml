@model ErrorViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Title ?? "خطأ";
}

<div class="empty-state empty-state-premium py-5">
    <div class="icon"><i class="bi bi-exclamation-triangle"></i></div>
    <span class="eyebrow text-danger mt-3">تعذر إكمال الطلب</span>
    <h4 class="mt-2">@Model.Title</h4>
    @if (Model.HasDetail)
    {
        <p>@Model.Detail</p>
    }
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary mt-2"><i class="bi bi-arrow-right"></i> العودة للوحة التحكم</a>
    }
    else
    {
        <a asp-controller="Auth" asp-action="Login" class="btn btn-primary mt-2"><i class="bi bi-box-arrow-in-left"></i> تسجيل الدخول</a>
    }
</div>
