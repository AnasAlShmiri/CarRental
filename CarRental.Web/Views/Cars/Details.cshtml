@model CarRental.Domain.Models.Car
@{
    ViewData["Title"] = $"تفاصيل السيارة — {Model.Brand} {Model.Model}";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <span class="text-uppercase" style="color:var(--primary);font-size:.7rem;font-weight:800;letter-spacing:.04em;">ملف السيارة</span>
        <h2 class="page-heading mb-0">@Model.Brand @Model.Model</h2>
        <p class="page-description">مراجعة المعلومات الحالية للسيارة وإدارة حالتها.</p>
    </div>
    <a asp-action="Index" class="btn btn-light btn-sm"><i class="bi bi-arrow-right"></i> العودة للسيارات</a>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="detail-media">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="صورة @Model.Brand @Model.Model" />
                }
                else
                {
                    <div class="text-center text-muted"><i class="bi bi-car-front" style="font-size:4.5rem;color:var(--primary);"></i><p class="mb-0 mt-2">لا توجد صورة مرفقة</p></div>
                }
            </div>
            <div class="card-body d-flex justify-content-between align-items-center gap-2">
                <div><small class="text-muted d-block">معرّف السيارة</small><strong style="color:var(--ink)">#@Model.Id</strong></div>
                @StatusPill(Model.Status)
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2"><span class="promo-icon"><i class="bi bi-info-circle"></i></span>بيانات السيارة</div>
            <div class="card-body">
                <dl class="row detail-list mb-0">
                    <dt class="col-sm-5">الموديل</dt><dd class="col-sm-7">@Model.Model</dd>
                    <dt class="col-sm-5">الماركة</dt><dd class="col-sm-7">@Model.Brand</dd>
                    <dt class="col-sm-5">السعر اليومي</dt><dd class="col-sm-7">@Model.PricePerDay.ToString("N2") ر.س <small class="text-muted fw-normal">/ يوم</small></dd>
                    <dt class="col-sm-5">الحالة الحالية</dt><dd class="col-sm-7">@StatusPill(Model.Status)</dd>
                    <dt class="col-sm-5">تاريخ الإضافة</dt><dd class="col-sm-7 text-muted" dir="ltr">@Model.CreatedAt.ToString("yyyy-MM-dd")</dd>
                </dl>
                <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> تعديل البيانات</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-light text-danger"><i class="bi bi-trash3"></i> حذف السيارة</a>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    Microsoft.AspNetCore.Html.IHtmlContent StatusPill(string status) => new Microsoft.AspNetCore.Html.HtmlString(status switch
    {
        "Available"        => "<span class=\"pill pill-available\">متاحة</span>",
        "Rented"           => "<span class=\"pill pill-rented\">مؤجَّرة</span>",
        "UnderMaintenance" => "<span class=\"pill pill-maintenance\">قيد الصيانة</span>",
        _ => $"<span class=\"pill\">{status}</span>"
    });
}
