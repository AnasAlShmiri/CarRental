@model CarRental.Domain.Models.Car
@{
    ViewData["Title"] = $"تفاصيل السيارة — {Model.Brand} {Model.Model}";
}

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card p-3">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="صورة السيارة" class="img-fluid rounded-3" style="max-height: 360px; width: 100%; object-fit: cover;" />
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center text-muted bg-light rounded-3" style="height: 280px; font-size: 4rem;"><i class="bi bi-car-front display-5"></i></div>
            }
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">بيانات السيارة</div>
            <div class="card-body">
                <dl class="row mb-0" style="font-size:.95rem">
                    <dt class="col-sm-5">الموديل</dt>
                    <dd class="col-sm-7 fw-semibold">@Model.Model</dd>
                    <dt class="col-sm-5">الماركة</dt>
                    <dd class="col-sm-7 fw-semibold">@Model.Brand</dd>
                    <dt class="col-sm-5">السعر اليومي</dt>
                    <dd class="col-sm-7 fw-semibold">@Model.PricePerDay.ToString("N2") ر.س</dd>
                    <dt class="col-sm-5">الحالة</dt>
                    <dd class="col-sm-7">@StatusPill(Model.Status)</dd>
                    <dt class="col-sm-5">تاريخ الإضافة</dt>
                    <dd class="col-sm-7 text-muted">@Model.CreatedAt.ToString("yyyy-MM-dd")</dd>
                </dl>
            </div>
        </div>
        <div class="d-flex gap-2 mt-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">تعديل</a>
            <a asp-action="Index" class="btn btn-soft">العودة للقائمة</a>
        </div>
    </div>
</div>

@{
    Microsoft.AspNetCore.Html.IHtmlContent StatusPill(string status) => new Microsoft.AspNetCore.Html.HtmlString(status switch
    {
        "Available"        => "<span class=\"pill pill-available\">متاحة</span>",
        "Rented"           => "<span class=\"pill pill-rented\">مؤجَّرة</span>",
        "UnderMaintenance" => "<span class=\"pill pill-maintenance\">قيد الصيانة</span>",
        _ => $"<span class=\"pill\">{status}</span>"
    });
}
