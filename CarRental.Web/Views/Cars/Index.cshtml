@model IEnumerable<CarRental.Domain.Models.Car>
@{
    ViewData["Title"] = "السيارات";
    var currentStatus = ViewData["CurrentStatus"] as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h2 class="page-heading mb-0">إدارة السيارات</h2>
        <p class="page-description">اعرض أسطول السيارات وحدّث بياناته وحالته بسهولة.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg ms-1"></i>إضافة سيارة</a>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div class="btn-group btn-group-sm" role="group" aria-label="تصفية حالة السيارات">
        <a class="btn @(currentStatus is null ? "btn-primary" : "btn-soft")" asp-action="Index">الكل</a>
        <a class="btn @(currentStatus == "Available" ? "btn-primary" : "btn-soft")" asp-action="Index" asp-route-status="Available">متاحة</a>
        <a class="btn @(currentStatus == "Rented" ? "btn-primary" : "btn-soft")" asp-action="Index" asp-route-status="Rented">مؤجَّرة</a>
        <a class="btn @(currentStatus == "UnderMaintenance" ? "btn-primary" : "btn-soft")" asp-action="Index" asp-route-status="UnderMaintenance">صيانة</a>
    </div>
    <span class="small text-muted">إجمالي السيارات: <strong class="text-dark">@Model.Count()</strong></span>
</div>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>السيارة</th>
                <th>الماركة</th>
                <th>السعر اليومي</th>
                <th>الحالة</th>
                <th>تاريخ الإضافة</th>
                <th class="text-start">الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var car in Model)
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            @if (!string.IsNullOrEmpty(car.ImageUrl))
                            {
                                <img src="@car.ImageUrl" alt="صورة @car.Brand @car.Model" class="avatar-thumb" />
                            }
                            else
                            {
                                <span class="avatar-initial">س</span>
                            }
                            <span class="fw-semibold text-dark">@car.Model</span>
                        </div>
                    </td>
                    <td>@car.Brand</td>
                    <td>@car.PricePerDay.ToString("N2") ر.س</td>
                    <td>@Html.Raw(StatusPill(car.Status))</td>
                    <td class="text-muted" dir="ltr">@car.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td class="text-start text-nowrap">
                        <a asp-action="Details" asp-route-id="@car.Id" class="action-btn btn-soft"><i class="bi bi-eye ms-1"></i>تفاصيل</a>
                        <a asp-action="Edit" asp-route-id="@car.Id" class="action-btn btn-soft"><i class="bi bi-pencil ms-1"></i>تعديل</a>
                        <button type="button" class="action-btn btn-soft text-danger btn-delete-car" data-bs-toggle="modal" data-bs-target="#deleteCarModal" data-car-id="@car.Id" data-car-name="@car.Model (@car.Brand)"><i class="bi bi-trash ms-1"></i>حذف</button>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6">
                        <div class="empty-state">
                            <div class="icon"><i class="bi bi-car-front"></i></div>
                            <div class="mt-2">لا توجد سيارات بعد — ابدأ بإضافة أول سيارة.</div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function () {
            $('.table').each(function () {
                $(this).DataTable({
                    language: {
                        emptyTable: "لا توجد بيانات",
                        info: "عرض _START_ إلى _END_ من _TOTAL_ سجل",
                        infoEmpty: "لا توجد سجلات",
                        infoFiltered: "(مفلتر من _MAX_ سجل)",
                        lengthMenu: "عرض _MENU_",
                        search: "بحث:",
                        zeroRecords: "لا توجد نتائج مطابقة",
                        paginate: { first: "الأول", last: "الأخير", next: "التالي", previous: "السابق" }
                    },
                    paging: true,
                    ordering: true,
                    searching: true,
                    info: true
                });
            });

            $('#deleteCarModal').on('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const id = button.getAttribute('data-car-id');
                const name = button.getAttribute('data-car-name');
                document.getElementById('deleteCarName').textContent = name;
                document.getElementById('deleteCarForm').action = '@Url.Action("Delete", "Cars")/' + id;
            });
        });
    </script>
}

<div class="modal fade" id="deleteCarModal" tabindex="-1" aria-labelledby="deleteCarModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="deleteCarModalLabel">
                    <i class="bi bi-exclamation-triangle-fill text-danger ms-2"></i>تأكيد الحذف
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">هل أنت متأكد من حذف السيارة <strong id="deleteCarName"></strong>؟ لا يمكن التراجع عن هذا الإجراء.</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-soft" data-bs-dismiss="modal">إلغاء</button>
                <form id="deleteCarForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">نعم، احذف</button>
                </form>
            </div>
        </div>
    </div>
</div>

@functions {
    string StatusPill(string status) => status switch
    {
        "Available"        => "<span class='pill pill-available'>متاحة</span>",
        "Rented"           => "<span class='pill pill-rented'>مؤجَّرة</span>",
        "UnderMaintenance" => "<span class='pill pill-maintenance'>قيد الصيانة</span>",
        _ => $"<span class='pill'>{status}</span>"
    };
}
