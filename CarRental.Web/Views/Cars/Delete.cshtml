@model CarRental.Domain.Models.Car
@{
    ViewData["Title"] = $"حذف السيارة — {Model.Brand} {Model.Model}";
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <span class="eyebrow text-danger"><i class="bi bi-shield-exclamation"></i> إجراء حساس</span>
        <h2 class="page-heading mb-0">تأكيد حذف السيارة</h2>
        <p class="page-description">راجع بيانات السيارة قبل تنفيذ الإجراء النهائي.</p>
    </div>
    <a asp-action="Index" class="btn btn-light"><i class="bi bi-arrow-right"></i> العودة إلى السيارات</a>
</div>

<div class="card danger-card mx-auto" style="max-width: 680px;">
    <div class="card-body p-4 p-lg-5">
        <div class="d-flex flex-wrap gap-3 align-items-center mb-4">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="صورة السيارة" class="avatar-thumb" style="width: 132px; height: 90px;" />
            }
            else
            {
                <span class="avatar-initial"><i class="bi bi-car-front"></i></span>
            }
            <div>
                <span class="text-muted small">سيارة رقم #@Model.Id</span>
                <h3 class="h5 text-dark mb-1">@Model.Brand @Model.Model</h3>
                <div class="small text-muted">السعر اليومي: @Model.PricePerDay.ToString("N2") ر.س</div>
            </div>
        </div>
        <div class="alert alert-danger d-flex gap-2 align-items-start mb-4">
            <i class="bi bi-exclamation-triangle-fill mt-1"></i>
            <span>هل أنت متأكد من حذف هذه السيارة؟ لا يمكن التراجع عن الإجراء، وستُحذف الصورة المرفوعة من الخادم.</span>
        </div>
        <form method="post" asp-action="Delete" asp-route-id="@Model.Id" class="form-actions">
            @Html.AntiForgeryToken()
            <a asp-action="Index" class="btn btn-light"><i class="bi bi-x-lg"></i> إلغاء</a>
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash3"></i> نعم، احذف السيارة</button>
        </form>
    </div>
</div>
