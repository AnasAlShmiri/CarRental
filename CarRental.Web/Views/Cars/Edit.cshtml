@model CarViewModel
@{
    ViewData["Title"] = $"تعديل السيارة — {Model.Brand} {Model.CarModel}";
}

<div class="card" style="max-width: 640px;">
    <div class="card-header">تعديل بيانات السيارة</div>
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="CarModel" class="form-label"></label>
                <input asp-for="CarModel" class="form-control" />
                <span asp-validation-for="CarModel" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Brand" class="form-label"></label>
                <input asp-for="Brand" class="form-control" />
                <span asp-validation-for="Brand" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PricePerDayText" class="form-label"></label>
                <div class="input-group" style="max-width: 320px;">
                    <input asp-for="PricePerDayText" class="form-control" type="text" inputmode="decimal" value="@Model.PricePerDayText" dir="ltr" />
                    <span class="input-group-text">ر.س</span>
                </div>
                <span asp-validation-for="PricePerDayText" class="text-danger"></span>
                <div class="form-text">اكتب السعر بالنقطة العشرية: 150.50</div>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select" style="max-width: 320px;">
                    <option value="">— اتركها كما هي —</option>
                    <option value="Available">متاحة</option>
                    <option value="Rented">مؤجَّرة</option>
                    <option value="UnderMaintenance">قيد الصيانة</option>
                </select>
                <div class="form-text">اتركها فارغة للحفاظ على الحالة الحالية</div>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Image" class="form-label"></label>
                <input asp-for="Image" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" />
                <div class="form-text">اختياري — اختيار ملف جديد يستبدل الصورة الحالية تلقائياً بعد التحقق من نوعها وحجمها الحقيقيين</div>
                <span asp-validation-for="Image" class="text-danger"></span>

                @if (!string.IsNullOrEmpty(Model.CurrentImageUrl))
                {
                    <div class="mt-3">
                        <img src="@Model.CurrentImageUrl" alt="الصورة الحالية" class="avatar-thumb" style="width: 160px; height: 110px; object-fit: cover; border: 1px solid var(--bs-border-color); border-radius: 8px;" />
                        <div class="form-check mt-2">
                            <input asp-for="RemoveImage" class="form-check-input" id="removeImage" />
                            <label asp-for="RemoveImage" class="form-check-label"></label>
                        </div>
                    </div>
                }
                else
                {
                    <div class="form-text mt-2 text-muted">لا توجد صورة حالية لهذه السيارة</div>
                }
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">حفظ التعديلات</button>
                <a asp-action="Index" class="btn btn-soft">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}
