@model CarViewModel
@{
    ViewData["Title"] = "إضافة سيارة";
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <span class="eyebrow"><i class="bi bi-car-front-fill"></i> إدارة الأسطول</span>
        <h2 class="page-heading mb-0">إضافة سيارة جديدة</h2>
        <p class="page-description">أضف سيارة إلى الأسطول مع بيانات واضحة وصورة تعريفية عالية الجودة.</p>
    </div>
    <a asp-action="Index" class="btn btn-light"><i class="bi bi-arrow-right"></i> العودة إلى السيارات</a>
</div>

<div class="form-layout">
    <section class="card form-card">
        <div class="card-header form-card-header">
            <div class="form-card-icon"><i class="bi bi-plus-circle-fill"></i></div>
            <div>
                <h3>بيانات السيارة</h3>
                <p>جميع الحقول الأساسية مطلوبة لإكمال الإدراج.</p>
            </div>
        </div>
        <div class="card-body p-4 p-lg-5">
            <form method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-4"></div>
                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="Brand" class="form-label"></label>
                        <div class="input-with-icon">
                            <i class="bi bi-building"></i>
                            <input asp-for="Brand" class="form-control" placeholder="مثال: تويوتا" />
                        </div>
                        <span asp-validation-for="Brand" class="text-danger field-validation-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CarModel" class="form-label"></label>
                        <div class="input-with-icon">
                            <i class="bi bi-car-front"></i>
                            <input asp-for="CarModel" class="form-control" placeholder="مثال: كامري" />
                        </div>
                        <span asp-validation-for="CarModel" class="text-danger field-validation-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PricePerDayText" class="form-label"></label>
                        <div class="input-group input-group-premium" dir="ltr">
                            <input asp-for="PricePerDayText" class="form-control" type="text" inputmode="decimal" placeholder="150.50" />
                            <span class="input-group-text">ر.س / يوم</span>
                        </div>
                        <span asp-validation-for="PricePerDayText" class="text-danger field-validation-error"></span>
                    </div>
                </div>
                <div class="form-section mt-5">
                    <div class="form-section-title"><i class="bi bi-image"></i> صورة السيارة</div>
                    <div class="image-upload-panel image-upload-panel-premium">
                        <div class="upload-icon"><i class="bi bi-cloud-arrow-up"></i></div>
                        <div class="fw-bold text-dark mb-1">ارفع صورة السيارة</div>
                        <div class="small text-muted mb-3">صورة واضحة بصيغة JPG أو PNG أو WEBP، وبحجم أقصى 5 ميجابايت.</div>
                        <input asp-for="Image" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" />
                        <span asp-validation-for="Image" class="text-danger field-validation-error text-start"></span>
                    </div>
                </div>
                <div class="form-actions mt-5">
                    <a asp-action="Index" class="btn btn-light"><i class="bi bi-x-lg"></i> إلغاء</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> حفظ السيارة</button>
                </div>
            </form>
        </div>
    </section>
    <aside class="form-aside">
        <div class="form-tip-card">
            <span class="tip-icon"><i class="bi bi-stars"></i></span>
            <h3>إدراج احترافي</h3>
            <p>استخدم صورة أمامية مضاءة جيدًا؛ ستظهر في البطاقات والتفاصيل داخل لوحة الإدارة.</p>
        </div>
        <div class="form-step-list">
            <div><span>01</span><p>معلومات السيارة</p></div>
            <div><span>02</span><p>السعر اليومي</p></div>
            <div><span>03</span><p>الصورة والحفظ</p></div>
        </div>
    </aside>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}
