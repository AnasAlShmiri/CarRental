@model CarViewModel
@{
    ViewData["Title"] = "إضافة سيارة";
}

<div class="card" style="max-width: 640px;">
    <div class="card-header">بيانات السيارة الجديدة</div>
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="CarModel" class="form-label"></label>
                <input asp-for="CarModel" class="form-control" placeholder="مثال: كامري" />
                <span asp-validation-for="CarModel" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Brand" class="form-label"></label>
                <input asp-for="Brand" class="form-control" placeholder="مثال: تويوتا" />
                <span asp-validation-for="Brand" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PricePerDayText" class="form-label"></label>
                <div class="input-group" style="max-width: 320px;">
                    <input asp-for="PricePerDayText" class="form-control" type="text" inputmode="decimal" placeholder="150.50" dir="ltr" />
                    <span class="input-group-text">ر.س</span>
                </div>
                <span asp-validation-for="PricePerDayText" class="text-danger"></span>
                <div class="form-text">اكتب السعر بالنقطة العشرية: 150.50 — تُقرأ القيمة بالثقافة المحايدة مهما كانت لغة المتصفح</div>
            </div>

            <div class="mb-3">
                <label asp-for="Image" class="form-label"></label>
                <input asp-for="Image" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" />
                <div class="form-text">اختياري — jpg / jpeg / png / gif / webp حتى 5 ميجابايت. يُتحقق من المحتوى الحقيقي للملف، ويُخزَّن باسم مولَّد آمن لا يُسمح له بالخروج من مجلد الصور</div>
                <span asp-validation-for="Image" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">إضافة السيارة</button>
                <a asp-action="Index" class="btn btn-soft">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}
