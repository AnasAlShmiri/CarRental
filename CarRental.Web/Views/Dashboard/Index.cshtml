@model CarRental.Application.DTOs.StatisticsDto
@{
    ViewData["Title"] = "لوحة التحكم";
    var selectedMonths = ViewContext.HttpContext.Request.Query["months"].ToString();
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <span class="text-uppercase" style="color:var(--primary);font-size:.7rem;font-weight:800;letter-spacing:.04em;">ملخص النشاط</span>
        <h2 class="page-heading mb-0">نظرة عامة على نشاطك</h2>
        <p class="page-description">تابع أسطول السيارات والإيجارات والإيرادات من مكان واحد.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-light btn-sm px-3" asp-controller="Rentals" asp-action="Create"><i class="bi bi-calendar2-plus"></i> حجز جديد</a>
        <a class="btn btn-primary btn-sm px-3" asp-controller="Cars" asp-action="Create"><i class="bi bi-plus-lg"></i> إضافة سيارة</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="stat-tile">
            <span class="stat-icon" aria-hidden="true"><i class="bi bi-car-front-fill"></i></span>
            <div>
                <div class="stat-label">إجمالي السيارات</div>
                <div class="stat-value">@Model.Cars.Total</div>
                <div class="stat-sub"><span class="text-success fw-bold">@Model.Cars.Available متاحة</span> · @Model.Cars.Rented مؤجرة</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-tile">
            <span class="stat-icon success" aria-hidden="true"><i class="bi bi-people-fill"></i></span>
            <div>
                <div class="stat-label">العملاء</div>
                <div class="stat-value">@Model.Customers.Total</div>
                <div class="stat-sub">إجمالي العملاء المسجلين</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-tile">
            <span class="stat-icon warning" aria-hidden="true"><i class="bi bi-calendar2-check-fill"></i></span>
            <div>
                <div class="stat-label">الإيجارات</div>
                <div class="stat-value">@Model.Rentals.Total</div>
                <div class="stat-sub"><span class="fw-bold" style="color:var(--warning)">@Model.Rentals.Active نشطة</span> · @Model.Rentals.Completed مكتملة</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-tile">
            <span class="stat-icon danger" aria-hidden="true"><i class="bi bi-wallet2"></i></span>
            <div>
                <div class="stat-label">الإيراد الكلي</div>
                <div class="stat-value">@Model.Revenue.Total.ToString("N0")</div>
                <div class="stat-sub">ريال سعودي من الإيجارات</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <section class="card h-100">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <strong>الإيراد الشهري</strong>
                    <small class="d-block mt-1" style="color:var(--muted);font-size:.72rem;font-weight:500;">متابعة أداء الإيرادات حسب الأشهر</small>
                </div>
                <div class="btn-group btn-group-sm" role="group" aria-label="المدة الزمنية للمخطط">
                    @foreach (var m in new[] { 3, 6, 12 })
                    {
                        var isSelected = selectedMonths == m.ToString() || (string.IsNullOrEmpty(selectedMonths) && m == 6);
                        <a class="btn @(isSelected ? "btn-primary" : "btn-soft")" asp-action="Index" asp-route-months="@m">@m أشهر</a>
                    }
                </div>
            </div>
            <div class="card-body">
                <div class="chart-area"><canvas id="revenueChart"></canvas></div>
            </div>
        </section>
    </div>
    <div class="col-lg-4">
        <section class="card h-100">
            <div class="card-header d-flex align-items-center gap-2"><span class="promo-icon"><i class="bi bi-graph-up-arrow"></i></span><span>ملخص الإيراد</span></div>
            <div class="card-body pt-4">
                <dl class="summary-list mb-0">
                    <dt>إيراد محقق <span class="pill pill-completed float-start">مكتمل</span></dt>
                    <dd>@Model.Revenue.Total.ToString("N2") ر.س</dd>
                    <dt>إيراد قيد التنفيذ <span class="pill pill-rented float-start">نشط</span></dt>
                    <dd class="mb-0">@Model.Revenue.ActiveValue.ToString("N2") ر.س</dd>
                </dl>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@@4"></script>
    <script>
        const months = @Html.Raw(ViewData["MonthsLabel"]);
        const revenue = @Html.Raw(ViewData["RevenueSeries"]);
        const canvas = document.getElementById('revenueChart');
        const chartContext = canvas.getContext('2d');
        const gradient = chartContext.createLinearGradient(0, 0, 0, 280);
        gradient.addColorStop(0, 'rgba(37, 99, 235, .88)');
        gradient.addColorStop(1, 'rgba(37, 99, 235, .28)');
        new Chart(canvas, {
            type: 'bar',
            data: { labels: months, datasets: [{ label: 'الإيراد (ر.س)', data: revenue, backgroundColor: gradient, hoverBackgroundColor: '#1D4ED8', borderRadius: 9, borderSkipped: false, maxBarThickness: 42 }] },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: { backgroundColor: '#0F172A', padding: 12, displayColors: false, cornerRadius: 10, callbacks: { label: ctx => `${ctx.parsed.y.toLocaleString('ar')} ر.س` } } },
                scales: { y: { beginAtZero: true, border: { display: false }, grid: { color: '#E2E8F0' }, ticks: { color: '#64748B', font: { family: 'Tajawal' } } }, x: { border: { display: false }, grid: { display: false }, ticks: { color: '#64748B', font: { family: 'Tajawal' } } } }
            }
        });
    </script>
}
