@model CarRental.Application.DTOs.StatisticsDto
@{
    ViewData["Title"] = "لوحة الإحصائيات";
}

<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="stat-tile">
            <div class="stat-label">إجمالي السيارات</div>
            <div class="stat-value">@Model.Cars.Total</div>
            <div class="stat-sub">
                متاح: @Model.Cars.Available · مؤجَّر: @Model.Cars.Rented · صيانة: @Model.Cars.UnderMaintenance
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-tile">
            <div class="stat-label">العملاء</div>
            <div class="stat-value">@Model.Customers.Total</div>
            <div class="stat-sub">كل العملاء المسجلين في النظام</div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-tile">
            <div class="stat-label">الإيجارات</div>
            <div class="stat-value">@Model.Rentals.Total</div>
            <div class="stat-sub">
                نشط: @Model.Rentals.Active · مكتمل: @Model.Rentals.Completed · ملغى: @Model.Rentals.Cancelled
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-tile">
            <div class="stat-label">الإيراد الكلي</div>
            <div class="stat-value">@Model.Revenue.Total.ToString("N0") <small style="font-size:.9rem;color:var(--muted)">ر.س</small></div>
            <div class="stat-sub">إيرادات الإيجارات المكتملة والنشطة</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>الإيراد الشهري</span>
                <div class="btn-group btn-group-sm" role="group">
                    @foreach (var m in new[] { 3, 6, 12 })
                    {
                        <a class="btn @(ViewContext.HttpContext.Request.Query["months"].ToString() == m.ToString() || (string.IsNullOrEmpty(ViewContext.HttpContext.Request.Query["months"]) && m == 6) ? "btn-gold" : "btn-soft")"
                           asp-action="Index" asp-route-months="@m">@m شهر</a>
                    }
                </div>
            </div>
            <div class="card-body">
                <canvas id="revenueChart" height="120"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">ملخص الإيراد</div>
            <div class="card-body">
                <dl class="mb-0">
                    <dt class="text-muted">إيراد محقق (مكتمل)</dt>
                    <dd class="fw-bold fs-5 mb-3">@Model.Revenue.Total.ToString("N2") ر.س</dd>
                    <dt class="text-muted">إيراد قيد التنفيذ (نشط)</dt>
                    <dd class="fw-bold fs-5">@Model.Revenue.ActiveValue.ToString("N2") ر.س</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@@4"></script>
    <script>
        const months = @Html.Raw(ViewData["MonthsLabel"]);
        const revenue = @Html.Raw(ViewData["RevenueSeries"]);

        new Chart(document.getElementById('revenueChart'), {
            type: 'bar',
            data: {
                labels: months,
                datasets: [{
                    label: 'الإيراد (ر.س)',
                    data: revenue,
                    backgroundColor: 'rgba(62, 132, 200, .75)',
                    borderColor: '#2c6ba3',
                    borderWidth: 1,
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: ctx => `${ctx.parsed.y.toLocaleString('ar')} ر.س`
                        }
                    }
                },
                scales: {
                    y: { beginAtZero: true, grid: { color: '#eef2f7' } },
                    x: { grid: { display: false } }
                }
            }
        });
    </script>
}
