@model CarRental.Domain.Models.Customer
@{
    ViewData["Title"] = $"تفاصيل العميل — {Model.Name}";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <span class="login-kicker"><i class="bi bi-person-badge"></i> ملف العميل</span>
        <h2 class="page-heading mt-2 mb-0">تفاصيل العميل</h2>
        <p class="page-description">مراجعة بيانات العميل ومعلومات التواصل المسجلة في النظام.</p>
    </div>
    <a asp-action="Index" class="btn btn-light btn-sm"><i class="bi bi-arrow-right"></i> العودة للعملاء</a>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card h-100 text-center">
            <div class="card-body d-flex flex-column align-items-center justify-content-center p-4">
                <span class="avatar-initial mb-3" style="width:72px;height:72px;font-size:1.5rem;">@Model.Name.Substring(0, 1)</span>
                <h3 class="h5 fw-bold text-dark mb-1">@Model.Name</h3>
                <p class="text-muted small mb-0">عميل مسجل في المنصة</p>
                <div class="d-flex gap-2 mt-4">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm"><i class="bi bi-pencil-square"></i> تعديل البيانات</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-light btn-sm text-danger"><i class="bi bi-trash3"></i></a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-person-lines-fill ms-2 text-primary"></i> معلومات العميل</div>
            <div class="card-body">
                <dl class="row detail-list mb-0">
                    <dt class="col-sm-4">الاسم الكامل</dt>
                    <dd class="col-sm-8">@Model.Name</dd>
                    <dt class="col-sm-4">البريد الإلكتروني</dt>
                    <dd class="col-sm-8" dir="ltr">@Model.Email</dd>
                    <dt class="col-sm-4">رقم الهاتف</dt>
                    <dd class="col-sm-8" dir="ltr">@Model.Phone</dd>
                    <dt class="col-sm-4">تاريخ التسجيل</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
