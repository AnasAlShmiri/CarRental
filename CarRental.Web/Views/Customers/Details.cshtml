@model CarRental.Domain.Models.Customer
@{
    ViewData["Title"] = $"تفاصيل العميل — {Model.Name}";
}

<div class="card" style="max-width: 640px;">
    <div class="card-header">بيانات العميل</div>
    <div class="card-body">
        <dl class="row mb-0" style="font-size:.95rem">
            <dt class="col-sm-5">الاسم</dt>
            <dd class="col-sm-7 fw-semibold">@Model.Name</dd>
            <dt class="col-sm-5">البريد الإلكتروني</dt>
            <dd class="col-sm-7 fw-semibold" dir="ltr" style="text-align:end">@Model.Email</dd>
            <dt class="col-sm-5">الهاتف</dt>
            <dd class="col-sm-7 fw-semibold" dir="ltr" style="text-align:end">@Model.Phone</dd>
            <dt class="col-sm-5">تاريخ التسجيل</dt>
            <dd class="col-sm-7 text-muted">@Model.CreatedAt.ToString("yyyy-MM-dd")</dd>
        </dl>
    </div>
    <div class="card-footer d-flex gap-2 bg-white border-0">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">تعديل</a>
        <a asp-action="Index" class="btn btn-soft">العودة للقائمة</a>
    </div>
</div>
