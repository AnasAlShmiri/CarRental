@model CarRental.Domain.Models.Customer
@{
    ViewData["Title"] = $"تعديل العميل — {Model.Name}";
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <span class="eyebrow"><i class="bi bi-person-gear"></i> إدارة العملاء</span>
        <h2 class="page-heading mb-0">تعديل بيانات العميل</h2>
        <p class="page-description">حدّث معلومات التواصل واحفظ التغييرات في ملف العميل.</p>
    </div>
    <a asp-action="Index" class="btn btn-light"><i class="bi bi-arrow-right"></i> العودة إلى العملاء</a>
</div>

<div class="form-layout form-layout-single">
    <section class="card form-card">
        <div class="card-header form-card-header">
            <div class="form-card-icon"><i class="bi bi-person-vcard-fill"></i></div>
            <div>
                <h3>ملف العميل</h3>
                <p>الرقم التعريفي: #@Model.Id</p>
            </div>
        </div>
        <div class="card-body p-4 p-lg-5">
            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-4"></div>
                <div class="row g-4">
                    <div class="col-12">
                        <label asp-for="Name" class="form-label"></label>
                        <div class="input-with-icon">
                            <i class="bi bi-person"></i>
                            <input asp-for="Name" class="form-control" autocomplete="name" />
                        </div>
                        <span asp-validation-for="Name" class="text-danger field-validation-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="input-with-icon" dir="ltr">
                            <i class="bi bi-envelope"></i>
                            <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger field-validation-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label"></label>
                        <div class="input-with-icon" dir="ltr">
                            <i class="bi bi-telephone"></i>
                            <input asp-for="Phone" class="form-control" autocomplete="tel" />
                        </div>
                        <span asp-validation-for="Phone" class="text-danger field-validation-error"></span>
                    </div>
                </div>
                <div class="form-actions mt-5">
                    <a asp-action="Index" class="btn btn-light"><i class="bi bi-x-lg"></i> إلغاء</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> حفظ التعديلات</button>
                </div>
            </form>
        </div>
    </section>
    <aside class="form-aside">
        <div class="form-tip-card">
            <span class="tip-icon"><i class="bi bi-pencil-square"></i></span>
            <h3>تحديث سريع</h3>
            <p>ستنعكس التغييرات مباشرة في سجل الحجوزات والإيجارات المرتبط بهذا العميل.</p>
        </div>
        <div class="form-step-list">
            <div><span><i class="bi bi-person"></i></span><p>بيانات شخصية</p></div>
            <div><span><i class="bi bi-envelope"></i></span><p>قنوات التواصل</p></div>
            <div><span><i class="bi bi-check2"></i></span><p>حفظ آمن</p></div>
        </div>
    </aside>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}
