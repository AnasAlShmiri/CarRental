@model CustomerViewModel
@{
    ViewData["Title"] = $"تعديل العميل — {Model.Name}";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h2 class="page-heading mb-0">تعديل بيانات العميل</h2>
        <p class="page-description">حدّث بيانات التواصل الخاصة بالعميل.</p>
    </div>
    <a asp-action="Index" class="btn btn-light btn-sm">← العودة إلى العملاء</a>
</div>

<div class="card mx-auto" style="max-width: 760px;">
    <div class="card-body p-4">
        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="email" dir="ltr" />
                    <span asp-validation-for="Email" class="text-danger field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" dir="ltr" />
                    <span asp-validation-for="Phone" class="text-danger field-validation-error"></span>
                </div>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-light px-3">إلغاء</a>
                <button type="submit" class="btn btn-primary px-3">حفظ التعديلات</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}
