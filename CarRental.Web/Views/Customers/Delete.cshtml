@model CarRental.Domain.Models.Customer
@{
    ViewData["Title"] = $"حذف العميل — {Model.Name}";
    var initial = string.IsNullOrWhiteSpace(Model.Name) ? "ع" : Model.Name[..1].ToUpperInvariant();
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <span class="eyebrow text-danger"><i class="bi bi-shield-exclamation"></i> إجراء حساس</span>
        <h2 class="page-heading mb-0">تأكيد حذف العميل</h2>
        <p class="page-description">راجع بيانات العميل قبل تنفيذ الإجراء النهائي.</p>
    </div>
    <a asp-action="Index" class="btn btn-light"><i class="bi bi-arrow-right"></i> العودة إلى العملاء</a>
</div>

<div class="card danger-card mx-auto" style="max-width: 680px;">
    <div class="card-body p-4 p-lg-5">
        <div class="d-flex gap-3 align-items-center mb-4">
            <span class="avatar-initial">@initial</span>
            <div>
                <span class="text-muted small">عميل رقم #@Model.Id</span>
                <h3 class="h5 text-dark mb-1">@Model.Name</h3>
                <div class="small text-muted" dir="ltr">@Model.Email</div>
            </div>
        </div>
        <div class="alert alert-danger d-flex gap-2 align-items-start mb-4">
            <i class="bi bi-exclamation-triangle-fill mt-1"></i>
            <span>هل أنت متأكد من حذف هذا العميل؟ إذا كان له سجل إيجارات فلن يتم الحذف حفاظًا على التكامل المرجعي مع الحسابات المالية.</span>
        </div>
        <form method="post" asp-action="Delete" asp-route-id="@Model.Id" class="form-actions">
            @Html.AntiForgeryToken()
            <a asp-action="Index" class="btn btn-light"><i class="bi bi-x-lg"></i> إلغاء</a>
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash3"></i> نعم، احذف العميل</button>
        </form>
    </div>
</div>
