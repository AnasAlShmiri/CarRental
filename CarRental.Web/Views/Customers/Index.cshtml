@model IEnumerable<CarRental.Domain.Models.Customer>
@{
    ViewData["Title"] = "العملاء";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted">إجمالي العملاء: <strong>@Model.Count()</strong></span>
    <a asp-action="Create" class="btn btn-primary">+ إضافة عميل</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>الاسم</th>
                    <th>البريد الإلكتروني</th>
                    <th>الهاتف</th>
                    <th>تاريخ التسجيل</th>
                    <th class="text-start">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Id</td>
                        <td class="fw-semibold">@c.Name</td>
                        <td dir="ltr" class="text-end">@c.Email</td>
                        <td dir="ltr" class="text-end">@c.Phone</td>
                        <td class="text-muted">@c.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td class="text-start">
                            <a asp-action="Details" asp-route-id="@c.Id" class="action-btn btn-soft">تفاصيل</a>
                            <a asp-action="Edit" asp-route-id="@c.Id" class="action-btn btn-soft">تعديل</a>
                            <a asp-action="Delete" asp-route-id="@c.Id" class="action-btn btn-soft text-danger">حذف</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                <div class="icon">☺</div>
                                لا يوجد عملاء بعد — أضف أول عميل
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
